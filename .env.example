# ══════════════════════════════════════════════════
# AgencyFlow Backend — Variables d'environnement
# À copier dans Vercel → Settings → Environment Variables
# ══════════════════════════════════════════════════

# ── SÉCURITÉ ──────────────────────────────────────
# Génère une chaîne aléatoire longue (ex: openssl rand -hex 32)
JWT_SECRET=change_moi_avec_une_vraie_valeur_aleatoire_longue

# ── ADMIN PAR DÉFAUT ──────────────────────────────
# Ton email + hash bcrypt de ton mot de passe
# Pour générer le hash : node -e "require('bcryptjs').hash('TON_MOT_DE_PASSE', 10).then(console.log)"
ADMIN_EMAIL=admin@tonagence.fr
ADMIN_PASS_HASH=$2a$10$REMPLACE_PAR_TON_VRAI_HASH_BCRYPT

# ── META ADS ──────────────────────────────────────
# developers.facebook.com → Mes Apps → ton app → Paramètres de base
META_APP_ID=ton_app_id_facebook
META_APP_SECRET=ton_app_secret_facebook

# ── SHOPIFY ───────────────────────────────────────
# partners.shopify.com → Apps → ton app → API credentials
SHOPIFY_API_KEY=ton_api_key_shopify
SHOPIFY_API_SECRET=ton_api_secret_shopify

# ── GOOGLE ADS ────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
# ads.google.com → Tools → API Center → Developer Token
GOOGLE_DEV_TOKEN=ton_developer_token_google_ads

# ── TIKTOK ADS ────────────────────────────────────
# business.tiktok.com → My Apps → ton app
TIKTOK_APP_ID=ton_app_id_tiktok
TIKTOK_APP_SECRET=ton_app_secret_tiktok

# ── URL DU PROJET (auto-rempli par Vercel) ────────
# Vercel l'injecte automatiquement — ne pas toucher
# VERCEL_URL=ton-projet.vercel.app
